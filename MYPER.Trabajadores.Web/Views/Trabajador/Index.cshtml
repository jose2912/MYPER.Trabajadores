@model List<MYPER.Trabajadores.Entity.Trabajador>

@{
    ViewData["Title"] = "Lista de Trabajadores";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<!-- Filtro por nombre, documento y sexo -->
<form method="get" asp-action="Index" class="form-inline mb-3">
    <input type="text" name="filtro" class="form-control mr-2" placeholder="Buscar por nombre o documento..." />

    <select name="sexo" class="form-control mr-2">
        <option value="">-- Sexo --</option>
        <option value="Masculino">Masculino</option>
        <option value="Femenino">Femenino</option>
    </select>

    <button type="submit" class="btn btn-outline-primary">Buscar</button>
    <a asp-action="Index" class="btn btn-outline-secondary ml-2">Limpiar</a>
</form>

<!-- Botón para abrir modal de registro -->
<button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCrear">
    Nuevo Trabajador
</button>



<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Documento</th>
            <th>Sexo</th>
            <th>Fecha Nacimiento</th>
            <th>Dirección</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>

        @{
            if (Model != null)
            {
                foreach (var t in Model)
                {
                    var color = t.Sexo == "Masculino" ? "table-primary" : "table-warning";
                    <tr class="@color">
                        <td>@t.Nombres</td>
                        <td>@t.Apellidos</td>
                        <td>@t.TipoDocumento - @t.NumeroDocumento</td>
                        <td>@t.Sexo</td>
                        <td>@(t.FechaNacimiento.HasValue ? t.FechaNacimiento.Value.ToShortDateString() : "Sin fecha")</td>
                        <td>@t.Direccion</td>
                        <td>
                             <!-- <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-warning">Editar</a>
                         -->
                            <!-- <button type="button" class="btn btn-sm btn-warning btn-editar" data-id="@t.Id">Editar</button>-->
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>

